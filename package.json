{
  "name": "pi-permission-modes",
  "version": "2.7.2",
  "type": "module",
  "description": "Switchable, user-definable permission modes for the pi coding agent. Each mode pairs an OS-level sandbox (bubblewrap, sandbox-exec, native Windows) with an allow / ask / deny policy for every tool. Default, Plan Mode, Build and YOLO ship; retune them or add your own. Live network prompts, plan approval, background shells with port exposure.",
  "license": "MIT",
  "author": "Nico Merz <nico.merz@wyna-informatik.ch>",
  "homepage": "https://github.com/wynainfo/pi-permission-modes#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wynainfo/pi-permission-modes.git"
  },
  "bugs": {
    "url": "https://github.com/wynainfo/pi-permission-modes/issues"
  },
  "keywords": [
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "pi-package",
    "permission",
    "permissions",
    "sandbox",
    "bubblewrap",
    "security",
    "plan-mode",
    "tree-sitter",
    "policy",
    "opencode"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "src/",
    "!src/**/*.test.ts",
    "schemas/",
    "docs/",
    "permission-mode.defaults.json",
    "defaults-history.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "scripts": {
    "postinstall": "echo 'permission-mode: dependencies installed.'",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "video": "https://github.com/wynainfo/pi-permission-modes/releases/download/v2.7.2/pi-permission-modes-demo-web.mp4"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.81",
    "tree-sitter-bash": "^0.25.1",
    "web-tree-sitter": "^0.25.10"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
