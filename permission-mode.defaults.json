{
  "$schema": "./schemas/permission-mode.schema.json",
  "defaultMode": "default",
  "cycleOrder": [
    "default",
    "plan",
    "build",
    "auto",
    "yolo"
  ],
  "groups": {
    "sandbox-base": {
      "sandbox": {
        "enabled": true,
        "writable": true,
        "allowWrite": [
          ".",
          "/tmp/pi"
        ],
        "denyWrite": [],
        "denyRead": [
          "~/.ssh",
          "~/.aws",
          "~/.gnupg",
          "~/.netrc",
          "~/.git-credentials",
          "~/.pypirc",
          "~/.gem/credentials",
          "~/.vault-token",
          "~/.password-store",
          "~/.pi/agent/auth.json",
          "~/.pi/agent/oauth.json"
        ],
        "network": {
          "allowedDomains": [
            "npmjs.org",
            "*.npmjs.org",
            "registry.npmjs.org",
            "registry.yarnpkg.com",
            "pypi.org",
            "*.pypi.org",
            "github.com",
            "*.github.com",
            "api.github.com",
            "raw.githubusercontent.com"
          ],
          "deniedDomains": []
        }
      }
    },
    "sandbox-plan": {
      "extends": [
        "sandbox-base"
      ],
      "sandbox": {
        "writable": false
      }
    },
    "read-tools": {
      "permission": {
        "path": {
          "*": "allow"
        },
        "external_directory": "ask",
        "read": "allow",
        "grep": "allow",
        "find": "allow",
        "ls": "allow"
      }
    },
    "ask-strict": {
      "permission": {
        "write": "ask",
        "edit": "ask",
        "bash": {
          "*": "ask"
        },
        "web_search": "ask",
        "tool": "ask",
        "skill": "ask"
      }
    },
    "allow-all": {
      "permission": {
        "write": "allow",
        "edit": "allow",
        "bash": {
          "*": "allow"
        },
        "web_search": "allow",
        "tool": "allow",
        "skill": "allow"
      }
    }
  },
  "modes": {
    "default": {
      "label": "Default",
      "color": "muted",
      "extends": [
        "sandbox-base",
        "read-tools",
        "ask-strict"
      ]
    },
    "plan": {
      "label": "Plan Mode",
      "color": "mdLink",
      "systemPrompt": "@plan",
      "extends": [
        "sandbox-plan",
        "read-tools"
      ],
      "permission": {
        "write": {
          "*": "deny",
          "*.md": "allow",
          "*.markdown": "allow"
        },
        "edit": {
          "*": "deny",
          "*.md": "allow",
          "*.markdown": "allow"
        },
        "bash": {
          "*": "allow"
        },
        "web_search": "allow",
        "tool": "ask",
        "skill": "ask"
      }
    },
    "build": {
      "label": "Build",
      "color": "accent",
      "extends": [
        "sandbox-base",
        "read-tools",
        "allow-all"
      ]
    },
    "auto": {
      "label": "Auto",
      "color": "warning",
      "extends": [
        "sandbox-base",
        "read-tools",
        "allow-all"
      ],
      "classifier": {
        "model": "current",
        "strictness": 0.5,
        "onRefuse": "refuse"
      }
    },
    "yolo": {
      "label": "YOLO",
      "color": "error",
      "sandbox": {
        "enabled": false,
        "writable": true
      },
      "bypassProtectedPaths": true,
      "permission": {
        "path": {
          "*": "allow"
        },
        "external_directory": "allow",
        "read": "allow",
        "write": "allow",
        "edit": "allow",
        "grep": "allow",
        "find": "allow",
        "ls": "allow",
        "bash": {
          "*": "allow"
        },
        "web_search": "allow",
        "tool": "allow",
        "skill": "allow"
      }
    }
  }
}
